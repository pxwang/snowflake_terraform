# Local directory for data, caching, and downloaded provider plugins
.terraform/
.terraform.lock.hcl


# Ignore all variable files containing production passwords, tokens, or private keys
*.tfvars
*.tfvars.json

# Ignore custom deployment scripts that pass local environment variables
*.env
.env*

# Ignore locally generated RSA key-pair material used for Snowflake key-pair auth
*.p8
*.pem
rsa_key*
